{
  "manifest_version": 3,
  "name": "Media Tool",
  "short_name": "Media Tool",
  "version": "0.2.0",
  "description": "Central do Media Tool local: importa publicações e perfis do Instagram, acompanha a atividade, processa e exporta pela API local.",
  "key": "",
  "action": {
    "default_title": "Media Tool",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "minimum_chrome_version": "116"
}
