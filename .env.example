# Media Tool: exemplo de configuração local.
# Copie para .env na raiz do projeto só se precisar mudar algum valor. O .env nunca é versionado.
# Precedência: variáveis do ambiente do processo > .env > padrões internos.
# Caminhos relativos são resolvidos a partir da raiz do projeto.

# Rede (o backend só escuta em 127.0.0.1). O scripts\start.ps1 define HOST e PORT para o processo do backend
# a partir do parâmetro -Port (padrão 8765), sobrepondo os valores abaixo.
MEDIA_TOOL_HOST=127.0.0.1
MEDIA_TOOL_PORT=8765

# MEDIA_TOOL_DEV: NÃO defina aqui. O scripts\start.ps1 -Dev define MEDIA_TOOL_DEV=1 só no processo do backend
# (libera a origem do Vite em 127.0.0.1:5173). Definir no .env liberaria essa origem também fora do modo dev.

# Quantidade de jobs processados em paralelo (1 a 4).
MEDIA_TOOL_CONCURRENCY=1

# Caminho completo do ffmpeg.exe / ffprobe.exe. Vazio = procurar no PATH.
MEDIA_TOOL_FFMPEG=
MEDIA_TOOL_FFPROBE=

# Pastas (vazio = padrão: data, storage, logs, data\secrets).
MEDIA_TOOL_DATA_DIR=
MEDIA_TOOL_STORAGE_DIR=
MEDIA_TOOL_LOG_DIR=
MEDIA_TOOL_SECRETS_DIR=

# Tamanho máximo de cada download, em bytes (padrão 2147483648 = 2 GiB).
MEDIA_TOOL_MAX_DOWNLOAD_BYTES=2147483648

# Sessão do Instagram: deixe VAZIO.
# O caminho recomendado é a tela Configurações do painel ou o script scripts\set-instagram-session.ps1,
# que guardam a sessão cifrada com DPAPI (usuário atual do Windows) em data\secrets\instagram-session.bin.
# Esta variável é só um fallback e fica em texto puro: evite usá-la.
INSTAGRAM_SESSIONID=

# Teto de páginas de listagem do Instagram por hora (configuração técnica, sem botão na interface).
# Padrão: 600 (linha comentada = padrão). 0 = SEM teto horário, só para POC de escala. Não afeta as outras
# proteções (1 requisição em voo, intervalo entre requisições, backpressure, pausas, 429, checkpoint).
# Valor inválido volta para 600. Prevalece sobre MEDIA_TOOL_IG_MAX_PAGES_PER_HOUR.
# INSTAGRAM_PAGE_RATE_LIMIT=600

# Fuso da data nos nomes dos arquivos exportados (Baixar ZIP / Exportar para pasta). Nome IANA.
# Sem esta variável vale o fuso do Windows (com as regras de horário de verão do ano de cada publicação).
# Exige o pacote tzdata (instalado pelo setup). Mudou o valor? Reinicie o Media Tool.
# MEDIA_TOOL_TIMEZONE=America/Sao_Paulo
